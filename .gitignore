/target
**/target
Cargo.lock
*.264
*.h264
*.yuv
!bench/**/*.rs

# Speed-test corpus: multi-GB real source video, fetched reproducibly by
# video-tests/fetch_clips.sh (the script + manifest ARE tracked, the pixels are not).
/video-tests/clips/
/video-tests/results/

# Junction to remade_ffmpeg_rs/.claude/skills (shared skills; not part of this repo)
.claude/skills/

# Generated RD/benchmark artifacts (decoded YUV, frame dumps, probe binaries).
# Regenerable from the encoder; 4+ GiB and individual files over GitHub's 100 MB
# limit, so they must never be tracked.
bench/_map/

# Benchmark corpus built by bench/decode_x264_speedtest.sh (x264 streams + 40MB concatenations).
# Regenerable; never commit.
_xbench/

# Great-gate test bed: reference copies imported from FFai (suppressor + fit
# harness). Private prior art for local testing; never commit to the public repo.
_greatgate/

# Prometheus CASC harvest output: prom-entropy JSONL, ~142 MB for a 4.7M-bin
# sweep and regenerable in one command. Data, not source — and large enough
# that a stray `git add -A` would be painful to undo.
bench/harvest_out/
**/cabac-bins.jsonl

# Scratch target dirs used for --emit asm / ISA comparisons.
target-asm*/
target-native/

# Benchmark scratch corpora (regenerable by bench/decode_benchmark.sh and the
# x264 head-to-head harnesses; hundreds of MB of looped YUV/y4m and streams).
_dprof/
_h2h/
_h2hq/
_h2hspeed/
_cspeed/
