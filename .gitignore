/target
**/target
Cargo.lock
*.264
*.h264
*.yuv
!bench/**/*.rs

# Speed-test corpus: multi-GB real source video, fetched reproducibly by
# video-tests/fetch_clips.sh (the script + manifest ARE tracked, the pixels are not).
/video-tests/clips/
/video-tests/results/

# Junction to remade_ffmpeg_rs/.claude/skills (shared skills; not part of this repo)
.claude/skills/

# Generated RD/benchmark artifacts (decoded YUV, frame dumps, probe binaries).
# Regenerable from the encoder; 4+ GiB and individual files over GitHub's 100 MB
# limit, so they must never be tracked.
bench/_map/

# Benchmark corpus built by bench/decode_x264_speedtest.sh (x264 streams + 40MB concatenations).
# Regenerable; never commit.
_xbench/

# Scratch target dirs used for --emit asm / ISA comparisons.
target-asm*/
target-native/
